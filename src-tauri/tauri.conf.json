{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BeamLink",
  "version": "0.1.0",
  "identifier": "app.beamlink.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BeamLink",
        "width": 1320,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 660,
        "center": true,
        "decorations": true,
        "backgroundColor": "#07070b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage", "dmg"],
    "category": "Game",
    "shortDescription": "BeamMP launcher and server browser",
    "longDescription": "BeamLink installs and drives the official BeamMP multiplayer stack for BeamNG.drive, with a fast server browser, favorites, one-click join and mod management.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "displayLanguageSelector": false
      }
    }
  }
}
